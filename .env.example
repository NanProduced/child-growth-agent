# 复制本文件为 .env 并填写。
# 注意：自定义环境变量请勿使用 COZE_ 开头（该前缀保留给平台）。

# Postgres 直连连接串。
# 本地开发写入 .env；扣子编程生产环境会自动注入 PGDATABASE_URL，优先使用 DATABASE_URL。
DATABASE_URL=

# 教师登录口令（最小身份验证，AUTH2 接入前仍供现有业务路由过渡使用）。
# 未配置时旧登录接口返回 503（configured:false），所有需要教师身份的操作不可用。
# AI 整理凭证（COZE_API_TOKEN 等）与此无关，由平台在部署环境自动注入，本地无需配置。
# 口令只保存在服务端环境变量中，请勿提交到代码仓库；更换后所有旧会话立即失效。
TEACHER_PASSCODE=

# 单园所账号与授权 v1（AUTH1，仅认证与教师管理后端；尚未接入业务路由）
# 可信公开源（逗号分隔，含协议与端口，如 https://example.com）。未配置时登录与登录后写保护返回 503（fail closed）；
# 可信源只来自本配置，不信任 Host / X-Forwarded-* 请求头。
AUTH_TRUSTED_ORIGINS=
# 单园所标识（可选，默认 single-school）
AUTH_SCHOOL_ID=
# 会话 Cookie 是否强制 Secure；留空时按可信源是否全部为 https 自动判断
AUTH_COOKIE_SECURE=
# 登录失败限流（进程内固定窗口，多实例不共享计数；仅作基础防线）
AUTH_LOGIN_RATE_LIMIT_MAX=10
AUTH_LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# 阶跃星辰token plan 本地测试使用
STEPFUN_API_KEY=
LLM_PROVIDER=coze
STEPFUN_BASE_URL=https://api.stepfun.com/step_plan/v1
STEPFUN_MODEL=step-5-preview
# StepFun 单次请求超时毫秒数；留空使用 60000，允许范围 1000-120000。
STEPFUN_TIMEOUT_MS=
