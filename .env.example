# 复制本文件为 .env 并填写。
# 注意：自定义环境变量请勿使用 COZE_ 开头（该前缀保留给平台）。

# Postgres 直连连接串。
# 本地开发写入 .env；扣子编程生产环境会自动注入 PGDATABASE_URL，优先使用 DATABASE_URL。
DATABASE_URL=

# 旧教师口令已退役；新版只使用账号/会话/CSRF，不以此值授权。
TEACHER_PASSCODE=

# 单园所账号与授权 v1（已接入业务路由）
# 可信公开源（逗号分隔，含协议与端口，如 https://example.com）。未配置时登录与登录后写保护返回 503（fail closed）；
# 可信源只来自本配置，不信任 Host / X-Forwarded-* 请求头。
AUTH_TRUSTED_ORIGINS=
# 单园所标识（可选，默认 single-school）
AUTH_SCHOOL_ID=
# 会话 Cookie 是否强制 Secure；留空时按可信源是否全部为 https 自动判断
AUTH_COOKIE_SECURE=
# 登录失败限流（进程内固定窗口，多实例不共享计数；仅作基础防线）
AUTH_LOGIN_RATE_LIMIT_MAX=10
AUTH_LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# 阶跃星辰token plan 本地测试使用
STEPFUN_API_KEY=
LLM_PROVIDER=coze
STEPFUN_BASE_URL=https://api.stepfun.com/step_plan/v1
STEPFUN_MODEL=step-5-preview
# StepFun 单次请求超时毫秒数；留空使用 60000，允许范围 1000-120000。
STEPFUN_TIMEOUT_MS=

# 芽芽聊天可显式区分文本和图片 provider；未配置则沿用 LLM_PROVIDER。
YAYA_CHAT_TEXT_PROVIDER=stepfun
# Step 5 Preview 已接入授权图片字节；如实测不可用，可明确改回 coze，不做静默回退。
YAYA_CHAT_IMAGE_PROVIDER=stepfun
YAYA_COZE_MODEL=doubao-seed-2-0-mini-260215
# 服务端单 run 模型尝试上限（含重试，1-8）；留空沿用8，首轮受控 smoke 使用2。
YAYA_CHAT_MAX_MODEL_CALLS=
# 仅扣子平台注入 workload 身份的环境设置为 workload；Windows 本地留空。
# 这不是凭证。不得从 CLI/PAT 获取 token，也不得自行创建 COZE_ 系统变量。
YAYA_PLATFORM_AUTH=
# Windows 本地可用 local + 自有目录；生产必须平台 s3，不能用本地磁盘。
MEDIA_STORAGE_MODE=
MEDIA_ENVIRONMENT=
MEDIA_LOCAL_ROOT=
